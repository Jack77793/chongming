root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{nix,json,html,css,js,mjs,cjs,md,markdown}]
indent_size = 2

[*.{gd,gdshader}]
indent_style = tab
indent_size = 4
tab_width = 4

# Markdown uses trailing spaces for explicit line breaks.
[*.{md,markdown}]
trim_trailing_whitespace = false
